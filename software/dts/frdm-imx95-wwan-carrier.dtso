/*
 * FRDM-IMX95 + WWAN carrier rev 0.2 - device-tree overlay SKELETON
 *
 * *** UNTESTED. NOT COMPILED AGAINST A REAL BSP. DO NOT SHIP. ***
 *
 * Placeholders that MUST be resolved before use (see docs/open-issues.md):
 *   CARRIER_I2C        LPI2C controller label wired to J801 pins 3/4 (TODO: pick FRDM header pins)
 *   CARRIER_INT_GPIO   SoC GPIO controller + line for EXP_INT_N (J801 pin 5), must be IRQ-capable, 3.3 V pad
 *   CARRIER_RST_GPIO   SoC GPIO controller + line for EXP_RESET_N (J801 pin 6)
 *   pinctrl            pad mux for the above (I2C open-drain, INT with pull-up)
 *
 * Line names come from carrier-gpio-line-names.dtsi, GENERATED by tools/gen_interface.py from the
 * KiCad netlist; they match docs/hw-sw-interface.md.  Preprocess with cpp (see docs/linux-bringup.md).
 */
/dts-v1/;
/plugin/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/interrupt-controller/irq.h>
#include "carrier-gpio-line-names.dtsi"

/* ---- placeholders: edit these four lines ------------------------------------------------- */
#define CARRIER_I2C       lpi2c3          /* TODO: placeholder label */
#define CARRIER_INT_CTRL  gpio2           /* TODO: placeholder */
#define CARRIER_INT_LINE  0               /* TODO: placeholder */
#define CARRIER_RST_CTRL  gpio2           /* TODO: placeholder */
#define CARRIER_RST_LINE  1               /* TODO: placeholder */
/* ------------------------------------------------------------------------------------------- */

&CARRIER_I2C {
	#address-cells = <1>;
	#size-cells = <0>;
	clock-frequency = <100000>;	/* raise to 400 kHz after bring-up test T2 */
	status = "okay";

	/* U801: slot power/FCPO/RESET/WDIS/PCIE_EN + HUB_RESET_N - ALL OUTPUTS.
	 * Consumers must request lines with an explicit initial value (see power-reset-sequencing.md sec. 9). */
	carrier_exp0: gpio@20 {
		compatible = "ti,tca6416";
		reg = <0x20>;
		gpio-controller;
		#gpio-cells = <2>;
		interrupt-controller;
		#interrupt-cells = <2>;
		interrupts-extended = <&CARRIER_INT_CTRL CARRIER_INT_LINE IRQ_TYPE_LEVEL_LOW>;
		/* EXP_RESET_N is shared by U801/U802; pca953x requests it exclusively, so only this node owns it. */
		reset-gpios = <&CARRIER_RST_CTRL CARRIER_RST_LINE GPIO_ACTIVE_LOW>;
		gpio-line-names = CARRIER_GPIO_NAMES_20;
	};

	/* U802: power-good + WAKE# inputs, user LEDs, spares. Shares the open-drain INT# net with U801. */
	carrier_exp1: gpio@21 {
		compatible = "ti,tca6416";
		reg = <0x21>;
		gpio-controller;
		#gpio-cells = <2>;
		interrupt-controller;
		#interrupt-cells = <2>;
		interrupts-extended = <&CARRIER_INT_CTRL CARRIER_INT_LINE IRQ_TYPE_LEVEL_LOW>;
		gpio-line-names = CARRIER_GPIO_NAMES_21;
	};

	/*
	 * Optional: USB5744 SMBus attach by the kernel (CONFIG_USB_ONBOARD_DEV_USB5744).
	 * Address 0x2d is from the Linux binding example, NOT yet confirmed on our board (VERIFY with i2cdetect).
	 * Also needs usb424,2744 / usb424,5744 child nodes under the FRDM USB controller that the carrier's
	 * USB-C cable plugs into, with i2c-bus = <&carrier_usbhub>.  Until that node is known, leave this
	 * disabled and use `carrierctl.py hub-attach`.
	 */
	carrier_usbhub: usb-hub@2d {
		compatible = "microchip,usb5744";
		reg = <0x2d>;
		status = "disabled";
	};

	/* PI7C9X3G606GP (0x6F per DS43484, VERIFY - datasheet examples also show 0x68) sits behind the
	 * PCA9306 translator. No Linux driver; configuration/debug access only via i2c-dev. Not described here. */
};

/*
 * PCIe: no nodes needed. The switch (12d8:c008) and the Qualcomm-based module endpoints (17cb:0308, mhi-pci-generic) are enumerated.
 * If late power-on of slots causes BAR assignment failures, see docs/linux-bringup.md "Known issues" #1.
 */
